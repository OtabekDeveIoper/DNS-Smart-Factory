model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(200)
  timezone  String   @default("Asia/Seoul") @db.VarChar(50)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plants    Plant[]
  roles     Role[]
  customers Customer[]
  materials Material[]

  @@unique([code])
}

model Plant {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @db.VarChar(50)
  name           String   @db.VarChar(200)
  timezone       String   @default("Asia/Seoul") @db.VarChar(50)
  address        String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  areas          Area[]
  userPlantRoles UserPlantRole[]
  orders         Order[]
  inventoryLots  InventoryLot[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Area {
  id        String   @id @default(uuid()) @db.Uuid
  plantId   String   @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plant           Plant            @relation(fields: [plantId], references: [id])
  productionLines ProductionLine[]

  @@unique([plantId, code])
  @@index([plantId])
}

model ProductionLine {
  id        String   @id @default(uuid()) @db.Uuid
  areaId    String   @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  area        Area         @relation(fields: [areaId], references: [id])
  workCenters WorkCenter[]

  @@unique([areaId, code])
  @@index([areaId])
}

model WorkCenter {
  id               String   @id @default(uuid()) @db.Uuid
  productionLineId String   @db.Uuid
  code             String   @db.VarChar(50)
  name             String   @db.VarChar(200)
  capacity         Decimal  @default(1) @db.Decimal(12, 3)
  capacityUnit     String   @default("UNIT") @db.VarChar(30)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productionLine ProductionLine @relation(fields: [productionLineId], references: [id])
  equipment      Equipment[]

  @@unique([productionLineId, code])
  @@index([productionLineId])
}

model Equipment {
  id            String          @id @default(uuid()) @db.Uuid
  workCenterId  String          @db.Uuid
  code          String          @db.VarChar(80)
  name          String          @db.VarChar(200)
  equipmentType String          @db.VarChar(80)
  status        EquipmentStatus @default(ACTIVE)
  mqttNodeId    String?         @db.VarChar(200)
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  workCenter WorkCenter @relation(fields: [workCenterId], references: [id])

  @@unique([workCenterId, code])
  @@index([workCenterId])
  @@index([mqttNodeId])
}
