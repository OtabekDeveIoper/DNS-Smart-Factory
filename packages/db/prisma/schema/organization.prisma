model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(200)
  timezone  String   @default("Asia/Seoul") @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plants Plant[]

  @@unique([code])
  @@map("organizations")
}

model Plant {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(50)
  name           String   @db.VarChar(200)
  timezone       String   @default("Asia/Seoul") @db.VarChar(50)
  address        String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  areas        Area[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("plants")
}

model Area {
  id        String   @id @default(uuid()) @db.Uuid
  plantId   String   @map("plant_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plant           Plant            @relation(fields: [plantId], references: [id])
  productionLines ProductionLine[]

  @@unique([plantId, code])
  @@index([plantId])
  @@map("areas")
}

model ProductionLine {
  id        String   @id @default(uuid()) @db.Uuid
  areaId    String   @map("area_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  area        Area         @relation(fields: [areaId], references: [id])
  workCenters WorkCenter[]

  @@unique([areaId, code])
  @@index([areaId])
  @@map("production_lines")
}

model WorkCenter {
  id               String   @id @default(uuid()) @db.Uuid
  productionLineId String   @map("production_line_id") @db.Uuid
  code             String   @db.VarChar(50)
  name             String   @db.VarChar(200)
  capacity         Decimal  @default(1) @db.Decimal(12, 3)
  capacityUnit     String   @default("UNIT") @map("capacity_unit") @db.VarChar(30)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  productionLine ProductionLine @relation(fields: [productionLineId], references: [id])
  equipment      Equipment[]

  @@unique([productionLineId, code])
  @@index([productionLineId])
  @@map("work_centers")
}

model Equipment {
  id           String          @id @default(uuid()) @db.Uuid
  workCenterId String          @map("work_center_id") @db.Uuid
  code         String          @db.VarChar(80)
  name         String          @db.VarChar(200)
  equipmentType String         @map("equipment_type") @db.VarChar(80)
  status       EquipmentStatus @default(ACTIVE)
  mqttNodeId   String?         @map("mqtt_node_id") @db.VarChar(200)
  metadata     Json?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  workCenter WorkCenter @relation(fields: [workCenterId], references: [id])

  @@unique([workCenterId, code])
  @@index([workCenterId])
  @@index([mqttNodeId])
  @@map("equipment")
}