POSTGRES_USER=smartops
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=smartops
DATABASE_URL=postgresql://smartops:replace-with-a-strong-password@db:5432/smartops?schema=public

# Browser-visible URLs. NEXT_PUBLIC_API_URL is embedded during the Web image build.
WEB_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api

API_PORT=3000
WEB_PORT=3001
ENABLE_SWAGGER=true
