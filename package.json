{
  "name": "dns_smart_factory",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "db:generate": "npm run db:generate -w packages/db",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:deploy": "npm run db:deploy -w packages/db",
    "db:seed": "npm run db:seed -w packages/db",
    "db:tables": "docker compose exec db psql -U smartops -d smartops -c \"\\dt\"",
    "deploy:up": "docker compose --env-file deploy/.env -f docker-compose.prod.yml up --build -d --wait",
    "deploy:down": "docker compose --env-file deploy/.env -f docker-compose.prod.yml down",
    "deploy:logs": "docker compose --env-file deploy/.env -f docker-compose.prod.yml logs -f api web",
    "deploy:seed": "docker compose --env-file deploy/.env -f docker-compose.prod.yml --profile tools run --rm seed"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.2.2"
    }
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OtabekDeveIoper/DNS-Smart-Factory.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/OtabekDeveIoper/DNS-Smart-Factory/issues"
  },
  "homepage": "https://github.com/OtabekDeveIoper/DNS-Smart-Factory#readme"
}
