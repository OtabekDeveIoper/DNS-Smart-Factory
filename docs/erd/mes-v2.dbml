Project DNS_Smart_Factory_MES_V2 {
  database_type: "PostgreSQL"
  Note: "Production-grade discrete manufacturing MES. Timescale hypertables are marked in table notes."
}

Enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

Enum RevisionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

Enum WorkOrderStatus {
  DRAFT
  PLANNED
  RELEASED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

Enum UnitStatus {
  CREATED
  READY
  IN_PROGRESS
  QUALITY_HOLD
  REWORK
  COMPLETED
  SCRAPPED
  CANCELLED
}

Enum UnitOperationStatus {
  PENDING
  READY
  IN_PROGRESS
  PAUSED
  BLOCKED
  COMPLETED
  REWORK_REQUIRED
  SKIPPED
  CANCELLED
}

Enum EquipmentStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RETIRED
}

Enum InventoryTransactionType {
  GOODS_RECEIPT
  RESERVATION
  RESERVATION_RELEASE
  ISSUE_TO_PRODUCTION
  RETURN_FROM_PRODUCTION
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  SCRAP
}

Enum ReservationStatus {
  ACTIVE
  PARTIALLY_ISSUED
  ISSUED
  RELEASED
  CANCELLED
}

Enum InspectionResult {
  PENDING
  PASS
  FAIL
  REWORK_REQUIRED
  CANCELLED
}

Enum NonConformanceStatus {
  OPEN
  UNDER_REVIEW
  DISPOSITIONED
  CLOSED
  CANCELLED
}

Enum DispositionType {
  REWORK
  SCRAP
  USE_AS_IS
  RETURN_TO_SUPPLIER
}

Enum AiJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  RETRY_SCHEDULED
  FAILED
  CANCELLED
}

Enum AiRecommendation {
  PASS_SUGGESTED
  FAIL_SUGGESTED
  REVIEW_REQUIRED
}

Enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

Enum Severity {
  INFO
  WARNING
  CRITICAL
}

Table Organization {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name varchar(200) [not null]
  timezone varchar(50) [not null, default: "Asia/Seoul"]
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
}

Table Plant {
  id uuid [pk]
  organizationId uuid [not null]
  code varchar(50) [not null]
  name varchar(200) [not null]
  timezone varchar(50) [not null, default: "Asia/Seoul"]
  address text
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (organizationId, code) [unique]
  }
}

Table Area {
  id uuid [pk]
  plantId uuid [not null]
  code varchar(50) [not null]
  name varchar(200) [not null]
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (plantId, code) [unique]
  }
}

Table ProductionLine {
  id uuid [pk]
  areaId uuid [not null]
  code varchar(50) [not null]
  name varchar(200) [not null]
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (areaId, code) [unique]
  }
}

Table WorkCenter {
  id uuid [pk]
  productionLineId uuid [not null]
  code varchar(50) [not null]
  name varchar(200) [not null]
  capacity decimal(12,3) [not null, default: 1]
  capacityUnit varchar(30) [not null, default: "UNIT"]
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (productionLineId, code) [unique]
  }
}

Table Equipment {
  id uuid [pk]
  workCenterId uuid [not null]
  code varchar(80) [not null]
  name varchar(200) [not null]
  equipmentType varchar(80) [not null]
  status EquipmentStatus [not null, default: "ACTIVE"]
  mqttNodeId varchar(200)
  metadata jsonb
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (workCenterId, code) [unique]
    mqttNodeId
  }
}

Table ShiftDefinition {
  id uuid [pk]
  plantId uuid [not null]
  code varchar(50) [not null]
  name varchar(100) [not null]
  startTime time [not null]
  endTime time [not null]
  crossesMidnight boolean [not null, default: false]
  isActive boolean [not null, default: true]

  indexes {
    (plantId, code) [unique]
  }
}

Table WorkCalendarDay {
  id uuid [pk]
  plantId uuid [not null]
  shiftDefinitionId uuid
  workDate date [not null]
  isWorkingDay boolean [not null]
  availableMinutes integer [not null, default: 0]
  note text

  indexes {
    (plantId, shiftDefinitionId, workDate) [unique]
  }
}

Table User {
  id uuid [pk]
  email varchar(320) [not null, unique]
  passwordHash text
  displayName varchar(150) [not null]
  employeeNo varchar(80)
  status UserStatus [not null, default: "INVITED"]
  locale varchar(10) [not null, default: "ko"]
  lastLoginAt timestamptz
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]
}

Table Role {
  id uuid [pk]
  organizationId uuid
  code varchar(80) [not null]
  name varchar(150) [not null]
  isSystem boolean [not null, default: false]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (organizationId, code) [unique]
  }

  Note: "Global role codes are additionally protected by a PostgreSQL partial unique index where organizationId is null."
}

Table Permission {
  id uuid [pk]
  code varchar(120) [not null, unique]
  description text [not null]
}

Table RolePermission {
  roleId uuid [not null]
  permissionId uuid [not null]

  indexes {
    (roleId, permissionId) [pk]
  }
}

Table UserSystemRole {
  userId uuid [not null]
  roleId uuid [not null]
  isActive boolean [not null, default: true]
  validFrom timestamptz
  validUntil timestamptz
  createdAt timestamptz [not null]

  indexes {
    (userId, roleId) [pk]
    (userId, isActive)
  }

  Note: "Platform-scoped assignments. The referenced role must have organizationId null."
}

Table UserPlantRole {
  id uuid [pk]
  userId uuid [not null]
  plantId uuid [not null]
  roleId uuid [not null]
  isActive boolean [not null, default: true]
  validFrom timestamptz
  validUntil timestamptz
  createdAt timestamptz [not null]

  indexes {
    (userId, plantId, roleId) [unique]
    (plantId, userId)
  }
}

Table Customer {
  id uuid [pk]
  organizationId uuid [not null]
  code varchar(80) [not null]
  name varchar(200) [not null]
  contactName varchar(150)
  email varchar(320)
  phone varchar(50)
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (organizationId, code) [unique]
  }
}

Table Product {
  id uuid [pk]
  organizationId uuid [not null]
  code varchar(80) [not null]
  name varchar(200) [not null]
  productType varchar(80) [not null]
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (organizationId, code) [unique]
  }
}

Table ProductRevision {
  id uuid [pk]
  productId uuid [not null]
  revision varchar(50) [not null]
  status RevisionStatus [not null, default: "DRAFT"]
  modelName varchar(150)
  description text
  effectiveFrom date
  effectiveUntil date
  publishedAt timestamptz
  publishedByUserId uuid
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (productId, revision) [unique]
  }
}

Table Material {
  id uuid [pk]
  organizationId uuid [not null]
  code varchar(80) [not null]
  name varchar(200) [not null]
  specification text
  category varchar(100) [not null]
  baseUnit varchar(30) [not null]
  leadTimeDays integer [not null, default: 0]
  safetyStock decimal(14,3) [not null, default: 0]
  lotControlled boolean [not null, default: true]
  serialControlled boolean [not null, default: false]
  shelfLifeDays integer
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (organizationId, code) [unique]
  }
}

Table BomRevision {
  id uuid [pk]
  productRevisionId uuid [not null]
  revision varchar(50) [not null]
  status RevisionStatus [not null, default: "DRAFT"]
  publishedAt timestamptz
  publishedByUserId uuid
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (productRevisionId, revision) [unique]
  }
}

Table BomItem {
  id uuid [pk]
  bomRevisionId uuid [not null]
  materialId uuid [not null]
  lineNo integer [not null]
  quantityPerUnit decimal(14,3) [not null]
  scrapRate decimal(7,4) [not null, default: 0]
  issueOperationSequence integer
  isOptional boolean [not null, default: false]
  notes text

  indexes {
    (bomRevisionId, lineNo) [unique]
    (bomRevisionId, materialId)
  }
}

Table OperationDefinition {
  id uuid [pk]
  organizationId uuid [not null]
  code varchar(80) [not null]
  name varchar(200) [not null]
  description text
  defaultStandardMinutes integer [not null]
  isActive boolean [not null, default: true]

  indexes {
    (organizationId, code) [unique]
  }
}

Table RoutingRevision {
  id uuid [pk]
  productRevisionId uuid [not null]
  revision varchar(50) [not null]
  status RevisionStatus [not null, default: "DRAFT"]
  publishedAt timestamptz
  publishedByUserId uuid
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (productRevisionId, revision) [unique]
  }
}

Table RoutingOperation {
  id uuid [pk]
  routingRevisionId uuid [not null]
  operationDefinitionId uuid [not null]
  defaultWorkCenterId uuid
  sequence integer [not null]
  standardMinutes integer [not null]
  setupMinutes integer [not null, default: 0]
  isMandatory boolean [not null, default: true]
  requiresQualityGate boolean [not null, default: false]
  instructions text

  indexes {
    (routingRevisionId, sequence) [unique]
  }
}

Table RoutingOperationPredecessor {
  routingOperationId uuid [not null]
  predecessorOperationId uuid [not null]

  indexes {
    (routingOperationId, predecessorOperationId) [pk]
  }
}

Table SalesOrder {
  id uuid [pk]
  organizationId uuid [not null]
  customerId uuid [not null]
  orderNo varchar(100) [not null]
  orderDate date [not null]
  status varchar(40) [not null]
  customerReference varchar(150)
  notes text
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (organizationId, orderNo) [unique]
    (customerId, orderDate)
  }
}

Table SalesOrderLine {
  id uuid [pk]
  salesOrderId uuid [not null]
  lineNo integer [not null]
  productRevisionId uuid [not null]
  orderedQuantity integer [not null]
  dueDate date [not null]
  notes text

  indexes {
    (salesOrderId, lineNo) [unique]
  }
}

Table WorkOrder {
  id uuid [pk]
  plantId uuid [not null]
  salesOrderLineId uuid
  productRevisionId uuid [not null]
  bomRevisionId uuid [not null]
  routingRevisionId uuid [not null]
  workOrderNo varchar(100) [not null]
  quantity integer [not null]
  status WorkOrderStatus [not null, default: "DRAFT"]
  priority integer [not null, default: 100]
  plannedStartAt timestamptz
  plannedEndAt timestamptz
  actualStartAt timestamptz
  actualEndAt timestamptz
  holdReason text
  version integer [not null, default: 1]
  createdByUserId uuid [not null]
  releasedByUserId uuid
  releasedAt timestamptz
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (plantId, workOrderNo) [unique]
    (plantId, status, plannedStartAt)
  }
}

Table WorkOrderOperation {
  id uuid [pk]
  workOrderId uuid [not null]
  routingOperationId uuid [not null]
  workCenterId uuid [not null]
  sequence integer [not null]
  operationCode varchar(80) [not null]
  operationName varchar(200) [not null]
  plannedStartAt timestamptz
  plannedEndAt timestamptz
  standardMinutes integer [not null]
  status varchar(40) [not null]
  version integer [not null, default: 1]

  indexes {
    (workOrderId, sequence) [unique]
    (workCenterId, status, plannedStartAt)
  }
}

Table Unit {
  id uuid [pk]
  workOrderId uuid [not null]
  serialNo varchar(120) [not null, unique]
  unitNumber integer [not null]
  status UnitStatus [not null, default: "CREATED"]
  currentOperationSequence integer
  startedAt timestamptz
  completedAt timestamptz
  version integer [not null, default: 1]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (workOrderId, unitNumber) [unique]
    (workOrderId, status)
  }
}

Table UnitOperation {
  id uuid [pk]
  unitId uuid [not null]
  workOrderOperationId uuid [not null]
  reworkOfOperationId uuid
  attemptNo integer [not null, default: 1]
  status UnitOperationStatus [not null, default: "PENDING"]
  assignedEquipmentId uuid
  startedByUserId uuid
  completedByUserId uuid
  startedAt timestamptz
  completedAt timestamptz
  goodQuantity decimal(14,3) [not null, default: 0]
  defectQuantity decimal(14,3) [not null, default: 0]
  blockReasonCode varchar(80)
  notes text
  version integer [not null, default: 1]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (unitId, workOrderOperationId, attemptNo) [unique]
    (status, startedAt)
  }
}

Table ProductionEvent {
  id uuid [pk]
  plantId uuid [not null]
  workOrderId uuid
  unitId uuid
  unitOperationId uuid
  eventType varchar(120) [not null]
  eventVersion integer [not null, default: 1]
  actorUserId uuid
  reasonCode varchar(80)
  payload jsonb
  correlationId uuid [not null]
  occurredAt timestamptz [not null]

  indexes {
    (unitId, occurredAt)
    (workOrderId, occurredAt)
    (eventType, occurredAt)
  }
}

Table Warehouse {
  id uuid [pk]
  plantId uuid [not null]
  code varchar(80) [not null]
  name varchar(200) [not null]
  isActive boolean [not null, default: true]

  indexes {
    (plantId, code) [unique]
  }
}

Table StorageLocation {
  id uuid [pk]
  warehouseId uuid [not null]
  code varchar(100) [not null]
  name varchar(200) [not null]
  locationType varchar(50) [not null]
  isActive boolean [not null, default: true]

  indexes {
    (warehouseId, code) [unique]
  }
}

Table MaterialLot {
  id uuid [pk]
  materialId uuid [not null]
  plantId uuid [not null]
  lotNo varchar(120) [not null]
  supplierCode varchar(100)
  supplierLotNo varchar(120)
  receivedAt timestamptz [not null]
  manufacturedAt date
  expiresAt date
  qualityStatus varchar(40) [not null]
  createdAt timestamptz [not null]

  indexes {
    (plantId, lotNo) [unique]
    (materialId, expiresAt)
  }
}

Table InventoryTransaction {
  id uuid [pk]
  plantId uuid [not null]
  materialId uuid [not null]
  materialLotId uuid
  storageLocationId uuid [not null]
  transactionType InventoryTransactionType [not null]
  quantity decimal(14,3) [not null]
  unit varchar(30) [not null]
  referenceType varchar(80)
  referenceId uuid
  workOrderId uuid
  unitId uuid
  actorUserId uuid
  idempotencyKey varchar(200) [not null, unique]
  correlationId uuid [not null]
  occurredAt timestamptz [not null]
  notes text

  indexes {
    (materialLotId, occurredAt)
    (storageLocationId, materialId, occurredAt)
    (workOrderId, occurredAt)
  }
}

Table MaterialReservation {
  id uuid [pk]
  workOrderId uuid [not null]
  materialId uuid [not null]
  materialLotId uuid
  storageLocationId uuid
  requiredQuantity decimal(14,3) [not null]
  reservedQuantity decimal(14,3) [not null]
  issuedQuantity decimal(14,3) [not null, default: 0]
  status ReservationStatus [not null, default: "ACTIVE"]
  requiredAt timestamptz [not null]
  createdAt timestamptz [not null]
  updatedAt timestamptz [not null]

  indexes {
    (workOrderId, materialId)
    (materialLotId, status)
  }
}

Table MaterialConsumption {
  id uuid [pk]
  inventoryTransactionId uuid [not null, unique]
  workOrderId uuid [not null]
  unitId uuid
  unitOperationId uuid
  materialId uuid [not null]
  materialLotId uuid [not null]
  quantity decimal(14,3) [not null]
  consumedByUserId uuid [not null]
  consumedAt timestamptz [not null]

  indexes {
    (unitId, consumedAt)
    (materialLotId, consumedAt)
  }
}

Table InspectionPlan {
  id uuid [pk]
  organizationId uuid [not null]
  productRevisionId uuid
  routingOperationId uuid
  code varchar(100) [not null]
  name varchar(200) [not null]
  revision varchar(50) [not null]
  status RevisionStatus [not null, default: "DRAFT"]
  inspectionType varchar(80) [not null]
  publishedAt timestamptz
  publishedByUserId uuid

  indexes {
    (organizationId, code, revision) [unique]
  }
}

Table InspectionPlanItem {
  id uuid [pk]
  inspectionPlanId uuid [not null]
  sequence integer [not null]
  characteristicCode varchar(100) [not null]
  name varchar(200) [not null]
  dataType varchar(40) [not null]
  measurementUnit varchar(40)
  lowerLimit decimal(18,6)
  upperLimit decimal(18,6)
  required boolean [not null, default: true]
  aiSupported boolean [not null, default: false]

  indexes {
    (inspectionPlanId, sequence) [unique]
  }
}

Table InspectionRecord {
  id uuid [pk]
  plantId uuid [not null]
  inspectionPlanId uuid [not null]
  unitId uuid [not null]
  unitOperationId uuid
  aiHumanReviewId uuid
  result InspectionResult [not null, default: "PENDING"]
  inspectorUserId uuid
  startedAt timestamptz
  completedAt timestamptz
  notes text
  version integer [not null, default: 1]
  createdAt timestamptz [not null]

  indexes {
    (unitId, createdAt)
    (result, createdAt)
  }
}

Table MeasurementResult {
  id uuid [pk]
  inspectionRecordId uuid [not null]
  inspectionPlanItemId uuid [not null]
  numericValue decimal(18,6)
  textValue text
  booleanValue boolean
  result InspectionResult [not null]
  measuredAt timestamptz [not null]

  indexes {
    (inspectionRecordId, inspectionPlanItemId) [unique]
  }
}

Table NonConformance {
  id uuid [pk]
  plantId uuid [not null]
  ncrNo varchar(100) [not null]
  unitId uuid
  unitOperationId uuid
  inspectionRecordId uuid
  materialLotId uuid
  defectCode varchar(100) [not null]
  Severity Severity [not null]
  status NonConformanceStatus [not null, default: "OPEN"]
  description text [not null]
  disposition DispositionType
  dispositionNotes text
  reportedByUserId uuid [not null]
  dispositionedByUserId uuid
  reportedAt timestamptz [not null]
  dispositionedAt timestamptz
  closedAt timestamptz

  indexes {
    (plantId, ncrNo) [unique]
    (unitId, status)
  }
}

Table CapaAction {
  id uuid [pk]
  nonConformanceId uuid [not null]
  actionType varchar(40) [not null]
  description text [not null]
  ownerUserId uuid [not null]
  dueAt timestamptz [not null]
  completedAt timestamptz
  verifiedByUserId uuid
  verifiedAt timestamptz
  status varchar(40) [not null]
  createdAt timestamptz [not null]
}

Table Attachment {
  id uuid [pk]
  organizationId uuid [not null]
  ownerType varchar(80) [not null]
  ownerId uuid [not null]
  objectKey text [not null, unique]
  originalFileName text [not null]
  contentType varchar(150) [not null]
  byteSize bigint [not null]
  checksumSha256 varchar(64) [not null]
  uploadedByUserId uuid [not null]
  createdAt timestamptz [not null]

  indexes {
    (ownerType, ownerId)
    checksumSha256
  }
}

Table AiInspectionJob {
  id uuid [pk]
  plantId uuid [not null]
  unitId uuid [not null]
  unitOperationId uuid
  inspectionPlanItemId uuid
  inputAttachmentId uuid [not null]
  status AiJobStatus [not null, default: "PENDING"]
  deterministicKey varchar(200) [not null, unique]
  attemptCount integer [not null, default: 0]
  requestedByUserId uuid [not null]
  requestedAt timestamptz [not null]
  startedAt timestamptz
  completedAt timestamptz
  lastError text

  indexes {
    (plantId, status, requestedAt)
    (unitId, requestedAt)
  }
}

Table AiInferenceRun {
  id uuid [pk]
  aiInspectionJobId uuid [not null]
  provider varchar(80) [not null]
  model varchar(120) [not null]
  promptVersion varchar(50) [not null]
  schemaVersion varchar(50) [not null]
  providerResponseId varchar(200)
  recommendation AiRecommendation [not null]
  modelConfidence decimal(7,6)
  normalizedOutput jsonb [not null]
  inputTokens integer
  outputTokens integer
  estimatedCost decimal(14,6)
  latencyMs integer [not null]
  createdAt timestamptz [not null]

  indexes {
    (aiInspectionJobId, createdAt)
    (model, promptVersion, createdAt)
  }
}

Table AiHumanReview {
  id uuid [pk]
  aiInferenceRunId uuid [not null, unique]
  reviewerUserId uuid [not null]
  decision InspectionResult [not null]
  recommendationAccepted boolean [not null]
  notes text
  reviewedAt timestamptz [not null]
}

Table AuditLog {
  id uuid [pk]
  organizationId uuid [not null]
  plantId uuid
  actorUserId uuid
  actorType varchar(40) [not null]
  action varchar(120) [not null]
  entityType varchar(100) [not null]
  entityId uuid [not null]
  beforeData jsonb
  afterData jsonb
  reason text
  ipAddress inet
  userAgent text
  correlationId uuid [not null]
  occurredAt timestamptz [not null]

  indexes {
    (entityType, entityId, occurredAt)
    (actorUserId, occurredAt)
    (plantId, occurredAt)
  }
}

Table OutboxEvent {
  id uuid [pk]
  organizationId uuid [not null]
  plantId uuid
  aggregateType varchar(100) [not null]
  aggregateId uuid [not null]
  aggregateVersion integer [not null]
  eventType varchar(150) [not null]
  eventVersion integer [not null]
  payload jsonb [not null]
  status OutboxStatus [not null, default: "PENDING"]
  attemptCount integer [not null, default: 0]
  availableAt timestamptz [not null]
  occurredAt timestamptz [not null]
  lockedAt timestamptz
  lockedBy varchar(150)
  publishedAt timestamptz
  lastError text
  correlationId uuid [not null]
  causationId uuid
  idempotencyKey varchar(200) [not null, unique]

  indexes {
    (status, availableAt)
    (aggregateType, aggregateId, aggregateVersion)
    occurredAt
  }
}

Table InboundMessage {
  id uuid [pk]
  organizationId uuid [not null]
  plantId uuid
  source varchar(80) [not null]
  externalMessageId varchar(200) [not null]
  messageType varchar(150) [not null]
  messageVersion integer [not null]
  payload jsonb [not null]
  status varchar(40) [not null]
  receivedAt timestamptz [not null]
  processedAt timestamptz
  lastError text

  indexes {
    (source, externalMessageId) [unique]
    (status, receivedAt)
  }
}

Table TelemetryMetricDefinition {
  id uuid [pk]
  equipmentId uuid [not null]
  metricCode varchar(120) [not null]
  name varchar(200) [not null]
  valueType varchar(30) [not null]
  measurementUnit varchar(40)
  lowerLimit decimal(18,6)
  upperLimit decimal(18,6)
  isActive boolean [not null, default: true]

  indexes {
    (equipmentId, metricCode) [unique]
  }
}

Table TelemetryEvent {
  occurredAt timestamptz [not null]
  id uuid [not null]
  plantId uuid [not null]
  equipmentId uuid [not null]
  metricDefinitionId uuid
  metricCode varchar(120) [not null]
  numericValue decimal(20,8)
  textValue text
  measurementUnit varchar(40)
  qualityCode varchar(40)
  sourceMessageId varchar(200) [not null]
  payload jsonb
  ingestedAt timestamptz [not null]

  indexes {
    (occurredAt, id) [pk]
    (equipmentId, sourceMessageId, occurredAt) [unique]
    (equipmentId, metricCode, occurredAt)
    (plantId, occurredAt)
  }

  Note: "TimescaleDB hypertable partitioned by occurredAt. Raw telemetry retention applies."
}

Table EquipmentStateEvent {
  occurredAt timestamptz [not null]
  id uuid [not null]
  plantId uuid [not null]
  equipmentId uuid [not null]
  state varchar(50) [not null]
  reasonCode varchar(80)
  sourceMessageId varchar(200) [not null]
  workOrderId uuid
  unitId uuid
  payload jsonb
  ingestedAt timestamptz [not null]

  indexes {
    (occurredAt, id) [pk]
    (equipmentId, sourceMessageId, occurredAt) [unique]
    (equipmentId, occurredAt)
  }

  Note: "TimescaleDB hypertable used for runtime, idle, planned stop, unplanned stop, and fault states."
}

